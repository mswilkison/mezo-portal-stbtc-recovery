# Create a fresh wallet, and export the private key.
SEPOLIA_PRIVATE_KEY=

# From alchemy or similar
SEPOLIA_RPC_URL=

# Ethereum mainnet archive RPC, required for recovery preflight and fork tests.
MAINNET_RPC_URL=

# Only required for a direct mainnet deployment. Preflight is read-only.
MAINNET_PRIVATE_KEY=

# Optional override for the mainnet fork test's pinned block. Leave empty:
# it defaults to the reviewed manifest's snapshotBlock (see
# helpers/recovery-manifest.ts), so a re-pin cannot be shadowed by a stale
# value baked into .env.
MAINNET_FORK_BLOCK_NUMBER=

# Follow https://info.etherscan.com/api-keys/
ETHERSCAN_API_KEY=
