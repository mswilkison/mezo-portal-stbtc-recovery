{
  "name": "@mezo-org/contracts",
  "version": "0.4.0-dev.4",
  "license": "GPL-3.0",
  "scripts": {
    "clean": "hardhat clean && rm -rf cache/ artifacts/ typechain/",
    "build": "hardhat compile",
    "format": "npm run lint:eslint && npm run lint:sol && npm run lint:config",
    "format:fix": "npm run lint:eslint:fix && npm run lint:sol:fix && npm run lint:config:fix",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:sol": "solhint 'contracts/**/*.sol' && prettier --plugin=prettier-plugin-solidity --check 'contracts/**/*.sol'",
    "lint:sol:fix": "solhint 'contracts/**/*.sol' --fix && prettier --plugin=prettier-plugin-solidity --write 'contracts/**/*.sol'",
    "lint:config": "prettier --check '**/*.@(json|md)'",
    "lint:config:fix": "prettier --write '**/*.@(json|md)'",
    "prepare:env": "cp -n .env.example .env || true",
    "preflight:recovery": "npm run prepare:env && hardhat run scripts/prepare-stbtc-recovery.ts --network mainnet",
    "test": "npm run prepare:env && hardhat test",
    "test:recovery": "npm run prepare:env && hardhat test test/Portal.provenance.test.ts test/PortalStbtcRecovery.test.ts test/upgrades/PortalStbtcRecovery.upgrades.test.ts",
    "test:recovery:fork": "npm run prepare:env && NODE_ENV=recovery-fork-test hardhat test test/integration/PortalStbtcRecovery.mainnet.test.ts --network hardhat",
    "test:upgrades": "npm run prepare:env && NODE_ENV=upgrades-test hardhat test ./test/upgrades/*.test.ts --network mainnet_fork",
    "node": "hardhat node",
    "deploy": "npm run prepare:env && hardhat deploy"
  },
  "devDependencies": {
    "@keep-network/hardhat-helpers": "0.7.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.3",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/hardhat-upgrades": "^3.0.1",
    "@thesis-co/eslint-config": "^0.6.1",
    "@types/chai-as-promised": "^7.1.8",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "chai": "^4.3.10",
    "chai-as-promised": "^7.1.1",
    "dotenv-safer": "^1.0.0",
    "eslint": "^8.57.0",
    "ethers": "^6.9.2",
    "hardhat": "^2.19.4",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-deploy": "^0.11.45",
    "hardhat-gas-reporter": "^1.0.10",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^4.0.0",
    "solhint-config-thesis": "^0.1.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@keep-network/bitcoin-spv-sol": "3.4.0-solc-0.8",
    "@keep-network/tbtc-v2": "1.6.0-dev.26",
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/contracts-upgradeable": "5.0.2"
  }
}
